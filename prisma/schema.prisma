generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// An account. Authentication itself is handled by Netlify Identity
// (GoTrue) in production: this table just mirrors the identity user so
// goals can be owned. `passwordHash` is only used by the local preview's
// built-in identity shim (src/app/api/dev-identity) — always null on Neon.
model User {
  id           String    @id // Netlify Identity user id (uuid) in production
  email        String    @unique
  name         String?
  passwordHash String?
  // per-account app settings (theme + timezone) as JSON — synced across devices
  settings     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  goals        Goal[]
}

// A goal is either:
//  - "quantitative": a measurable target with a deadline (e.g. read 12 books
//    by the end of the year). Progress is the sum of ProgressLog amounts.
//  - "plan": a step-by-step plan to build a skill (e.g. learn guitar).
//    Progress is tracked through GoalStep completion + practice logs.
// Goals also carry a skill map (SkillPath/SkillNode), a weekly routine
// schedule (RoutineItem) and free-form notes (GoalNote).
model Goal {
  id           String         @id @default(cuid())
  userId       String? // owner; null = not yet claimed by an account
  user         User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  emoji        String         @default("🎯")
  color        String         @default("emerald")
  category     String? // e.g. "Music", "Fitness", "Learning" — used for filters
  type         String // "quantitative" | "plan"
  targetValue  Float? // quantitative: total target amount
  unit         String? // e.g. "books", "pages", "hours", "sessions", "km"
  weeklyTarget Float? // optional weekly commitment (mainly for plan goals)
  deadline     DateTime?
  status       String         @default("active") // active | archived
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  steps        GoalStep[]
  logs         ProgressLog[]
  notes        GoalNote[]
  routines     RoutineItem[]
  skillPaths   SkillPath[]
  skillNodes   SkillNode[]
  pbs          PersonalBest[]
}

// One step of a plan-type goal.
model GoalStep {
  id          String    @id @default(cuid())
  goalId      String
  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title       String
  notes       String?
  order       Int       @default(0)
  status      String    @default("pending") // pending | in_progress | done
  completedAt DateTime?
  // optional target date the user wants this step done by (their own
  // deadline for the step — the routine trigger decides completion, this
  // decides the "am I on track?" display)
  dueDate     DateTime?
  // ---- automation: how this step completes --------------------------------
  // "manual"  = ticked by hand (the classic checklist behaviour)
  // "routine" = completes after `triggerCount` check-offs of `routine`
  //             (null routine = any routine of the goal), counted from
  //             `currentSince` (null = the whole history counts)
  // "metric"  = completes when the rolling average of the last
  //             `metricWindow` attempts of the `metricName` PB crosses
  //             `metricValue` ("under" = avg must drop below it, e.g. a
  //             solve time; "over" = avg must rise above it, e.g. WPM)
  trigger       String    @default("manual")
  routineId     String?
  routine       RoutineItem? @relation("StepTriggerRoutine", fields: [routineId], references: [id], onDelete: SetNull)
  triggerCount  Int       @default(1)
  metricName    String?
  metricWindow  Int?
  metricOp      String? // "under" | "over"
  metricValue   Float?
  // when this step became the current one — check-offs before it count for
  // the previous step; stored at a UTC day boundary
  currentSince  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([goalId, order])
}

// A single logged unit of progress (pages read, a practice session, ...).
model ProgressLog {
  id        String   @id @default(cuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  amount    Float    @default(0)
  note      String?
  // The unit this amount was recorded in ("words", "min", "km") — set by
  // routine check-offs whose unit differs from the goal's own (a linked
  // checkpoint's unit, or a duration routine's minutes). Null = the goal's
  // unit, so pre-existing rows keep displaying exactly as before.
  unit      String?
  createdAt DateTime @default(now())

  @@index([goalId, date])
}

// Free-form note attached to a goal (insights, links, reflections...).
model GoalNote {
  id        String   @id @default(cuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  content   String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([goalId, createdAt])
}

// A recurring scheduled activity tied to a goal, e.g. "drills every 2 days"
// (cadence = "interval"), "focused practice every Sunday" (cadence =
// "weekly"), or "gym 3× a week, any day" (cadence = "flexible" — rest
// days built in, you choose the days).
// A routine may point at a skill node (nodeId): "what this session works on",
// e.g. Tuesday's session is grammar, Sunday's is speaking. Checking it off
// can add `credit` progress to that node automatically.
// `optional` marks an extra-credit session: nice to do, but skipping it never
// counts against adherence, streaks or the "open" catch-up list.
model RoutineItem {
  id           String       @id @default(cuid())
  goalId       String
  goal         Goal         @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title        String
  notes        String?
  cadence      String       @default("weekly") // "interval" | "weekly" | "flexible"
  everyNDays   Int? // interval: repeat every N days from startDate
  weekdays     String? // weekly: csv of weekday numbers, 0=Sun .. 6=Sat, e.g. "0,3"
  timesPerWeek Int? // flexible: N sessions per week, on any day
  nodeId       String? // optional: the skill node this session advances
  node         SkillNode?  @relation("RoutineFocus", fields: [nodeId], references: [id], onDelete: SetNull)
  credit       Float? // optional: progress added to the node per completed session
  durationMin  Int?
  startDate    DateTime     @default(now())
  endDate      DateTime? // null = repeat until the goal deadline / forever
  archived     Boolean      @default(false)
  optional     Boolean      @default(false) // extra credit: no penalty when skipped
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  dones        RoutineDone[]
  /// steps whose routine trigger points at this routine
  triggerSteps GoalStep[]   @relation("StepTriggerRoutine")

  @@index([goalId])
}

// Marks one occurrence (day) of a routine as completed. creditedValue
// records how much progress was auto-added to the linked skill node, and
// logId points at the progress-log entry auto-created on check-off, so an
// undo can take exactly that much back out.
model RoutineDone {
  id            String       @id @default(cuid())
  routineId     String
  routine       RoutineItem  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  date          DateTime // the occurrence day (normalized to midnight)
  creditedValue Float?
  logId         String? // the auto-created ProgressLog entry (undo deletes it)
  /// set when this check-off completed a step (routine trigger): undoing
  /// it re-opens exactly that step. Plain string, no FK — deleting the step
  /// just makes the undo a no-op.
  advancedStepId String?
  createdAt     DateTime     @default(now())

  @@unique([routineId, date])
  @@index([routineId, date])
}

// A vertical path in the skill map, e.g. "Vocabulary", "Grammar", "Shooting".
// Paths are independent branches; nodes inside are ordered tiers (HSK1 → 2 → 3).
model SkillPath {
  id          String       @id @default(cuid())
  goalId      String
  goal        Goal         @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title       String
  description String?
  icon        String       @default("🌿")
  unit        String? // default unit for nodes, e.g. "words"
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  nodes       SkillNode[]

  @@index([goalId, order])
}

// One tier of a path, with measurable progress (e.g. "HSK3 · 30/600 words").
// Status is derived: not_started (0) / in_progress / mastered (current >= target).
// A node with deriveFromId/deriveFactor is a *derived* checkpoint — a passive
// meter that converts another checkpoint's progress into its own unit (e.g.
// "Books finished": every 300 pages on "Pages read" = 1 book). Its progress
// updates automatically whenever the source does, and it ignores gating.
model SkillNode {
  id           String     @id @default(cuid())
  goalId       String
  goal         Goal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  pathId       String
  path         SkillPath  @relation(fields: [pathId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  icon         String     @default("✨")
  order        Int        @default(0)
  currentValue Float      @default(0)
  targetValue  Float      @default(100)
  unit         String? // overrides path unit
  xpValue      Int        @default(20)
  // csv of node ids that must be mastered before this one unlocks.
  // null/empty = the default ladder: the previous node in the same path
  // (HSK2 → HSK3). Explicit ids may cross paths ("Reading HSK3 needs
  // Vocabulary HSK2"). Ignored for derived checkpoints (they are meters).
  requiresIds  String?
  // derived checkpoint: source node + how many of its units make 1 of ours
  deriveFromId String?
  deriveFrom   SkillNode? @relation("DeriveLink", fields: [deriveFromId], references: [id], onDelete: SetNull)
  derived      SkillNode[] @relation("DeriveLink")
  deriveFactor Float? // e.g. 300 = every 300 pages of the source = 1 book
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  milestones   SkillMilestone[]
  focusRoutines RoutineItem[] @relation("RoutineFocus")
  /// personal-best metrics that feed this checkpoint automatically
  fedPbs        PersonalBest[] @relation("PbFeedsNode")

  @@index([pathId, order])
  @@index([goalId])
}

// A sub-checkpoint along the way to a node's target, e.g. 50 and 100 words
// on the road to the 150-word "HSK1" checkpoint. Keeps motivation up and
// feeds the quest-map pop-outs. reachedAt is derived from progress.
model SkillMilestone {
  id        String     @id @default(cuid())
  nodeId    String
  node      SkillNode  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  value     Float
  label     String?
  reachedAt DateTime?
  createdAt DateTime   @default(now())

  @@unique([nodeId, value])
  @@index([nodeId])
}

// A personal-best metric on a goal — e.g. "WPM" (higher = better) or
// "BLD solve" (lower = better). Every attempt is kept as a record in
// `history` (JSON) so the Review tab can chart how the PB moved over time;
// the current PB itself is always derived, never stored.
model PersonalBest {
  id        String   @id @default(cuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  name      String // e.g. "WPM", "BLD", "5K time"
  unit      String? // e.g. "wpm", "s", "kg"
  direction String   @default("up") // "up" = higher is better | "down" = lower is better
  history   String   @default("[]") // JSON: [{ id, date, value, note, creditedValue? }]
  // ---- roadmap link: feed a skill checkpoint from logged attempts ----
  // nodeId + nodeMode turn this metric into a tree feeder:
  //   "sum"     — every attempt adds its value to the checkpoint
  //               (words per session, pages per session, algs learned)
  //   "average" — the checkpoint MIRRORS the rolling average of the last
  //               nodeWindow attempts (typing speed climbing toward a bar);
  //               only for "up" metrics, since checkpoints master at >= target
  nodeId     String? 
  node       SkillNode? @relation("PbFeedsNode", fields: [nodeId], references: [id], onDelete: SetNull)
  nodeMode   String? // "sum" | "average" (null = not linked)
  nodeWindow Int? // average mode: rolling window (default 3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([goalId, name])
  @@index([goalId])
}
