# Local development (SQLite + the built-in preview identity shim).
# Prisma resolves relative file: paths against prisma/schema.prisma.
DATABASE_URL="file:../db/custom.db"

# Optional: change the signing key for the preview identity shim
# DEV_IDENTITY_SECRET="anything-random-here"

# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION — set this as an environment variable in Netlify instead:
#   Site configuration → Environment variables → DATABASE_URL
#
# Use Neon's POOLED connection string (the host contains "-pooler") and keep
# the pgbouncer + connection_limit params:
#
#   postgresql://USER:PASSWORD@EP-HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1
# ─────────────────────────────────────────────────────────────────────────────
